{
  "name": "Yamtrack",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin" },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Yamtrack", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "sudo chown vscode /home/vscode/.venv && curl -LsSf https://astral.sh/uv/install.sh | sh && npm i -g tailwindcss @tailwindcss/cli && ~/.local/bin/uv sync && ~/.local/bin/uv run src/manage.py migrate",
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python" },
      "extensions": ["ms-python.python", "charliermarsh.ruff", "monosans.djlint", "batisteo.vscode-django"]
    }
  }
}
